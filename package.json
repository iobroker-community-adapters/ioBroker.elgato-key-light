{
  "name": "iobroker.elgato-key-light",
  "version": "1.1.0",
  "description": "Control Elgato Wi-Fi lighting locally from ioBroker.",
  "author": "xXBJXx <issi.dev.iobroker@gmail.com>",
  "contributors": [
    "xXBJXx <issi.dev.iobroker@gmail.com>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.elgato-key-light",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Elgato",
    "Light",
    "Elgato Key Light"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.elgato-key-light.git"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.elgato-key-light/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "@alcalzone/esbuild-register": {
      "esbuild": "^0.25.0"
    },
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/**/*.{html,css,png,svg,jpg,js,json}",
    "build/",
    "README_DE.md",
    "docs/ELGATO_API.md",
    "docs/MIGRATION.md",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "install:all": "npm ci && npm --prefix src-admin ci && npm --prefix src-tab ci",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "npm run build:ts && npm run build:admin && npm run build:tab",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:admin": "npm --prefix src-admin run build",
    "build:tab": "npm --prefix src-tab run build",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "test:ts": "tsc -p tsconfig.test.json && node --test .test-build/elgato/parsers.test.js .test-build/elgato/ElgatoClient.test.js .test-build/elgato/ElgatoDiscovery.test.js .test-build/device-manager/DeviceManager.test.js .test-build/ioBroker/configuration.test.js .test-build/ioBroker/diagnostics.test.js .test-build/ioBroker/StateRepository.test.js",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:hardware": "npm run build:ts && node --test test/hardware.mjs",
    "test": "npm run test:ts && npm run test:package",
    "typecheck": "tsc --noEmit && npm --prefix src-admin run typecheck && npm --prefix src-tab run typecheck",
    "check": "npm run typecheck",
    "lint": "eslint -c eslint.config.mjs . && npm --prefix src-admin run lint && npm --prefix src-tab run lint",
    "elgato:probe": "npm run build:ts && node build/cli/probe.js",
    "translate": "translate-adapter",
    "release": "release-script"
  }
}
